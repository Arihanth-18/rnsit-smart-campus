# Copy to .env and fill in. Never commit .env.

# Neon: Console -> your project -> Connect -> copy the connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: only allow student sign-ups from this email domain, e.g. rnsit.edu.in
STUDENT_EMAIL_DOMAIN=

# Admin account, created/updated by `npm run db:migrate`
ADMIN_EMAIL=admin@rnsit.edu.in
ADMIN_PASSWORD=
ADMIN_NAME=Campus Administrator

# Only used by `npm run db:seed-demo`
DEMO_PASSWORD=
